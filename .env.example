# rss-expert
#
# Copy this to .env and edit it. .env is never committed.
# A .env.local, if it exists, is read first and wins over .env -- that is where
# a machine-specific override belongs, so the deployed .env stays untouched.
# Anything already set in the real environment beats both files.
#
# Only DOMAIN is required. Every line below shows its default.

# The public hostname this instance publishes in its feeds. No scheme, no path.
RSS_EXPERT_DOMAIN=example.org

# The port compose publishes on the host, and the only one anything outside
# needs to know. Inside the container the app always listens on 11080.
RSS_EXPERT_HTTP_PORT=11081

# Database, uploads and backups live here.
RSS_EXPERT_DATA_DIR=data

# The first owner account, created on the first boot only. If an owner already
# exists these are ignored and the log says so. There is no default password:
# leave them empty and no account is made.
RSS_EXPERT_ADMIN_EMAIL=
RSS_EXPERT_ADMIN_PASSWORD=

# The mail server for sign-in links, confirmation and recovery. Empty means no
# mail is sent and those flows are unavailable. Form:
#   smtp://user:password@host:587   (STARTTLS)  or  smtps://…:465  (TLS)
# A from address can ride on the URL: smtps://host?from=hello%40example.org
RSS_EXPERT_SMTP_URL=
RSS_EXPERT_MAIL_FROM=

# closed  — only the owner exists, accounts are made by invitation
# invite  — anyone with an invitation may register
# open    — anyone may register
RSS_EXPERT_REGISTRATION=closed

# Trust X-Forwarded-For and X-Forwarded-Proto. Off means they are ignored
# entirely, so nobody can claim an address or a scheme they do not have.
# Turn it on only when a proxy you control sets them.
RSS_EXPERT_BEHIND_PROXY=false

# ActivityPub. Off means the fediverse endpoints do not exist at all: no
# WebFinger, no inbox, no actor document. On means @handle@DOMAIN becomes a
# real address people can follow from Mastodon.
#
# Turning it on is close to permanent. Actor identifiers, key identifiers and
# post identifiers are absolute URLs on this domain, and the far side refuses
# anything whose origin does not match. Change the domain afterwards and the
# actor dies: old followers keep pointing at an address that answers nothing,
# and edits to old posts read as somebody else impersonating you.
#
# Settle the domain first. Then turn this on.
RSS_EXPERT_ACTIVITYPUB=false

# Operational ceilings.
RSS_EXPERT_MEDIA_QUOTA_MB=512
RSS_EXPERT_FETCH_LIMIT_MB=5
RSS_EXPERT_POLL_WORKERS=4

# Serve /dev/preview, the design page with sample data. Off in production.
RSS_EXPERT_SHOW_PREVIEW=false

# /metrics answers 404 while this is empty. Set a long random string and the
# endpoint opens to whoever carries it, as a bearer header or ?token=.
RSS_EXPERT_METRICS_TOKEN=

# text or json; debug, info, warn or error.
RSS_EXPERT_LOG_FORMAT=text
RSS_EXPERT_LOG_LEVEL=info
